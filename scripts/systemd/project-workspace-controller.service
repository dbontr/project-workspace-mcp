[Unit]
Description=Project Workspace MCP controller
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=project-workspace
Group=project-workspace
WorkingDirectory=/var/lib/project-workspace
Environment=HOME=/var/lib/project-workspace
Environment=PWM_DB=/var/lib/project-workspace/state.db
EnvironmentFile=-/etc/project-workspace/controller.env
ExecStart=/usr/local/bin/project-workspace-controller controller --listen 127.0.0.1:8000
StateDirectory=project-workspace
StateDirectoryMode=0700
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s

[Install]
WantedBy=multi-user.target

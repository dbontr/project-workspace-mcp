FROM golang:1.23-bookworm AS build
WORKDIR /src
COPY go.mod ./
COPY cmd ./cmd
COPY internal ./internal
RUN CGO_ENABLED=0 go build -trimpath -o /out/worker ./cmd/project-workspace-worker

FROM registry.k8s.io/kubectl:v1.34.1 AS kubectl
FROM debian:bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates && rm -rf /var/lib/apt/lists/*
COPY --from=build /out/worker /usr/local/bin/project-workspace-worker
COPY --from=kubectl /bin/kubectl /usr/local/bin/kubectl
USER 65534:65534
ENTRYPOINT ["/usr/local/bin/project-workspace-worker"]
